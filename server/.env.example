# Kunal's Ganna Juice — server environment
# Copy to .env and fill in real values.

PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# WhatsApp receipt flow:
# Leave WHATSAPP_API_TOKEN + WHATSAPP_PHONE_ID empty to use wa.me fallback links.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=

# Media storage: "local" (uploads/ folder) for dev. Cloudinary/S3 in production.
MEDIA_STORAGE=local

# Turso (LibSQL) — cloud SQLite persistence. Set BOTH to use Turso.
# Create a free DB at https://turso.tech, then:
#   turso db create ganna
#   turso db show ganna --url        # -> TURSO_DATABASE_URL
#   turso db tokens create ganna     # -> TURSO_AUTH_TOKEN
# Without these, the server falls back to the local file DB (dev only).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
